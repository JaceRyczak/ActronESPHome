# Copy this file to secrets.yaml in the same directory (or merge these keys
# into the ESPHome dashboard's shared secrets.yaml) and fill in real values.
# Do not commit the real secrets.yaml to version control.

wifi_ssid: "MyWiFi"
wifi_password: "CHANGE_ME"

# Used for the ESPHome native API encryption key. Generate one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "CHANGE_ME_32_BYTE_BASE64_KEY"

ota_password: "CHANGE_ME"

fallback_hotspot_password: "CHANGE_ME_min_8_chars"
